# Copy to config.env and edit. Environment variables with the same names override this file.
# Restart the server after a change.

# --- Basics -------------------------------------------------------------------
# 127.0.0.1 = only this machine (use with a tunnel or reverse proxy); 0.0.0.0 = every interface.
LB_HOST=127.0.0.1
LB_PORT=8790
# Day boundaries for "Today" / "This month" and the charts (IANA name, e.g. Europe/Berlin).
LB_TZ=UTC
LB_TITLE=Claude Code Leaderboard
# Interface language: en or id (Bahasa Indonesia).
LB_LANG=en
# Public base URL, used in the install commands. Empty = taken from the request's Host header.
LB_PUBLIC_URL=
# SQLite file. Default: data/leaderboard.db next to server.py.
# LB_DB=

# --- Admin ----------------------------------------------------------------------
# Passphrase for /admin (enter it once in the browser). Use a long random string.
LB_ADMIN_KEY=
# With Cloudflare Access: login emails that get /admin without the passphrase (comma-separated).
LB_ADMIN_EMAILS=

# --- Who can see the board --------------------------------------------------------
# Optional secret link for viewers without Cloudflare Access: share https://<host>/?key=<value> once,
# the browser keeps a cookie. Empty = anyone who can reach the server sees the board.
# Sending usage always needs a personal token, whatever you set here.
LB_VIEW_KEY=

# --- Cloudflare Access (optional, see docs/cloudflare.md) -----------------------------
# Team domain (xxx.cloudflareaccess.com) and the AUD tag of the Access app that protects the board.
# With both set, viewers are identified by their verified login email.
LB_CF_TEAM_DOMAIN=
LB_CF_VIEWER_AUD=
# Service token for the ingest paths; it is written into every participant's install command.
LB_CF_CLIENT_ID=
LB_CF_CLIENT_SECRET=
